  "autosequences": [
    {
      "id": "seq-safe",
      "name": "Safe All",
      "abbrev": "SAFE",
      "description": "Command every actuator to its configured safe state.",
      "style": "safe",
      "requiresArm": false,
      "confirm": false,
      "steps": [
        {
          "t": 0,
          "action": "log",
          "message": "Safing all actuators"
        },
        {
          "t": 0,
          "action": "bangbang",
          "target": "*",
          "enabled": false
        },
        {
          "t": 0.1,
          "action": "safeAll"
        }
      ],
      "abortConditions": [],
      "hidden": false,
      "duration": 0.1
    },
    {
      "id": "seq-pneumatics",
      "name": "Pneumatics On",
      "abbrev": "PNEU ON",
      "description": "Open N2 isolation and charge the pneumatic actuator supply.",
      "style": "normal",
      "requiresArm": false,
      "confirm": false,
      "steps": [
        {
          "t": 0,
          "action": "log",
          "message": "Charging pneumatics"
        },
        {
          "t": 0,
          "action": "valve",
          "target": "SV-N2-ISO",
          "state": "open"
        },
        {
          "t": 1.5,
          "action": "valve",
          "target": "SV-PNEU",
          "state": "open"
        },
        {
          "t": 5,
          "action": "log",
          "message": "Pneumatics charged"
        }
      ],
      "abortConditions": [],
      "hidden": false,
      "duration": 5
    },
    {
      "id": "seq-leakcheck",
      "name": "Leak Check",
      "abbrev": "LEAK CK",
      "description": "Low-pressure hold at 100 psi on both tanks for leak detection.",
      "style": "normal",
      "requiresArm": true,
      "confirm": false,
      "abortConditions": [
        {
          "sensor": "PT-201",
          "op": ">",
          "value": 200,
          "message": "Fuel tank overpressure during leak check"
        },
        {
          "sensor": "PT-301",
          "op": ">",
          "value": 200,
          "message": "Ox tank overpressure during leak check"
        }
      ],
      "steps": [
        {
          "t": 0,
          "action": "log",
          "message": "Leak check start"
        },
        {
          "t": 0,
          "action": "valve",
          "target": "SV-FV",
          "state": "closed"
        },
        {
          "t": 0,
          "action": "valve",
          "target": "SV-OV",
          "state": "closed"
        },
        {
          "t": 1,
          "action": "bangbang",
          "target": "bb-fuel",
          "enabled": true,
          "setpoint": 100,
          "deadband": 10
        },
        {
          "t": 1,
          "action": "bangbang",
          "target": "bb-ox",
          "enabled": true,
          "setpoint": 100,
          "deadband": 10
        },
        {
          "t": 60,
          "action": "bangbang",
          "target": "*",
          "enabled": false
        },
        {
          "t": 60.5,
          "action": "log",
