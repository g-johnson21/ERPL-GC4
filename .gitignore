# Recorded test data — keep the folder, not the runs.
data/*.csv
data/*.meta.json

# Reference traces from other stands, kept locally as format references
# rather than in the repo — they are megabytes of rows nothing reads.
TRITON_*.csv

# Timestamped config backups written on every save from the Config page.
config/backups/

# What the startup window (Start GC-4.bat) remembers for next time. Per-laptop
# by nature — the COM port and the ports in use are not the same at every desk.
config/launcher.settings.json

node_modules/
*.log
.DS_Store
Thumbs.db

# Python bytecode from the DAQ sidecar.
__pycache__/
