{
  "name": "erpl-gc4",
  "version": "4.0.0",
  "description": "ERPL Ground Control 4 - local webserver ground control software for liquid rocket test stands",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "sim": "node server/index.js --driver=simulator",
    "stand": "node server/index.js --driver=stand",
    "dev": "node --watch server/index.js",
    "test": "node --test \"server/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "dependencies": {
    "serialport": "^13.0.0"
  }
}
